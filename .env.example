VITE_SPOTIFY_CLIENT_ID=il_tuo_spotify_client_id

# Base URL OAuth (consigliato in produzione/Firebase)
# Esempio: https://spotifymigrationtool-d722b.web.app
# Se valorizzata, genera automaticamente:
#   <VITE_OAUTH_BASE_URL>/auth/source
#   <VITE_OAUTH_BASE_URL>/auth/destination
# VITE_OAUTH_BASE_URL=

# Redirect URI OAuth per frontend-only (opzionale, priorita piu alta)
# Se non impostati, usa automaticamente:
#   <origin>/auth/source
#   <origin>/auth/destination
VITE_SPOTIFY_SOURCE_REDIRECT_URI=http://127.0.0.1:5173/auth/source
VITE_SPOTIFY_DESTINATION_REDIRECT_URI=http://127.0.0.1:5173/auth/destination