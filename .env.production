# Produzione (Firebase Hosting)
# Progetto: spotifymigrationtool-d722b

# Obbligatorio: Client ID della tua app Spotify
VITE_SPOTIFY_CLIENT_ID=il_tuo_spotify_client_id

# Base URL usata per costruire i redirect OAuth:
#   https://spotifymigrationtool-d722b.web.app/auth/source
#   https://spotifymigrationtool-d722b.web.app/auth/destination
VITE_OAUTH_BASE_URL=https://spotifymigrationtool-d722b.web.app

# Opzionale: se valorizzati, questi due hanno priorita su VITE_OAUTH_BASE_URL
# VITE_SPOTIFY_SOURCE_REDIRECT_URI=https://spotifymigrationtool-d722b.web.app/auth/source
# VITE_SPOTIFY_DESTINATION_REDIRECT_URI=https://spotifymigrationtool-d722b.web.app/auth/destination
